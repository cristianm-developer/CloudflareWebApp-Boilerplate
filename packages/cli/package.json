{
  "name": "@cloudflare-apps/cli",
  "version": "0.1.0",
  "description": "Project generator and interactive configurator for the Cloudflare Apps boilerplate",
  "type": "module",
  "bin": {
    "cf-apps": "./src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
